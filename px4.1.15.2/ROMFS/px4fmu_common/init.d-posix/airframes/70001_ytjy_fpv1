#!/bin/sh
#
# @name YTJY FPV RPM=11111 MAS=1.0kg 推重比5:1
#
# @type Quadrotor Wide
#

. ${R}etc/init.d/rc.mc_defaults


# ==================================================================================================================
# 0. AirSim 机体和电机的几何描述
# ==================================================================================================================
param set-default CA_AIRFRAME 0                 # 设置机架类型为通用四轴; 范围[0-20]
param set-default CA_ROTOR_COUNT 4              # 设置电机数量为4; 范围[2-12]
param set-default CA_ROTOR0_PX 0.1515           # 电机0(前右)X坐标(米); 范围[-1, 1]
param set-default CA_ROTOR0_PY 0.245            # 电机0(前右)Y坐标(米); 范围[-1, 1]
param set-default CA_ROTOR0_KM 0.05             # 电机0力矩系数(CCW转向); 范围[-0.1, 0.1]
param set-default CA_ROTOR1_PX -0.1515          # 电机1(后左)X坐标(米); 范围[-1, 1]
param set-default CA_ROTOR1_PY -0.1875          # 电机1(后左)Y坐标(米); 范围[-1, 1]
param set-default CA_ROTOR1_KM 0.05             # 电机1力矩系数(CCW转向); 范围[-0.1, 0.1]
param set-default CA_ROTOR2_PX 0.1515           # 电机2(前左)X坐标(米); 范围[-1, 1]
param set-default CA_ROTOR2_PY -0.245           # 电机2(前左)Y坐标(米); 范围[-1, 1]
param set-default CA_ROTOR2_KM -0.05            # 电机2力矩系数(CW转向); 范围[-0.1, 0.1]
param set-default CA_ROTOR3_PX -0.1515          # 电机3(后右)X坐标(米); 范围[-1, 1]
param set-default CA_ROTOR3_PY 0.1875           # 电机3(后右)Y坐标(米); 范围[-1, 1]
param set-default CA_ROTOR3_KM -0.05            # 电机3力矩系数(CW转向); 范围[-0.1, 0.1]

param set-default PWM_MAIN_FUNC1 101            # 映射输出通道1为电机1功能; 101=Motor 1
param set-default PWM_MAIN_FUNC2 102            # 映射输出通道2为电机2功能; 102=Motor 2
param set-default PWM_MAIN_FUNC3 103            # 映射输出通道3为电机3功能; 103=Motor 3
param set-default PWM_MAIN_FUNC4 104            # 映射输出通道4为电机4功能; 104=Motor 4


# ==================================
# 1.位置控制器
# ==================================
# P项增益
param set MPC_XY_P 0.95
param set MPC_Z_P 1.0
# 最大速度限制
param set MPC_XY_VEL_MAX 20.0
param set MPC_Z_VEL_MAX_UP 8.0
param set MPC_Z_VEL_MAX_DN 8.0
# 轨迹等待与贴合
param set MPC_XY_ERR_MAX 2.0
param set MPC_XY_TRAJ_P 0.5


# ==================================
# 2.速度控制器
# ==================================
# 低通滤波
param set MPC_VEL_LP 0.0
param set MPC_VELD_LP 0.0
# 水平PID
param set MPC_XY_VEL_P_ACC 1.8
param set MPC_XY_VEL_I_ACC 0.4
param set MPC_XY_VEL_D_ACC 0.2
# 垂直PID
param set MPC_Z_VEL_P_ACC 1.0
param set MPC_Z_VEL_I_ACC 2.0
param set MPC_Z_VEL_D_ACC 0.0
# 最大加速度限制
param set MPC_ACC_HOR_MAX 48.0
param set MPC_ACC_UP_MAX 8.0
param set MPC_ACC_DOWN_MAX 8.0


# ==================================
# 3. 姿态控制器
# ==================================
# P项增益
param set MC_ROLL_P 10.0
param set MC_PITCH_P 10.0
param set MC_YAW_P 4.0
# 最大角速度限制
param set MC_ROLLRATE_MAX 1200.0
param set MC_PITCHRATE_MAX 1200.0
param set MC_YAWRATE_MAX 400.0


# ==================================
# 4. 角速度控制器
# ==================================
# 低通滤波
param set IMU_GYRO_CUTOFF 0.0
param set IMU_DGYRO_CUTOFF 0.0
# FF + K-PID 滚动角速度
param set MC_ROLLRATE_FF 0.1
param set MC_ROLLRATE_K 1.0
param set MC_ROLLRATE_P 0.11
param set MC_ROLLRATE_I 0.25
param set MC_ROLLRATE_D 0.0010
# FF + K-PID 仰角速度
param set MC_PITCHRATE_FF 0.1
param set MC_PITCHRATE_K 1.0
param set MC_PITCHRATE_P 0.11
param set MC_PITCHRATE_I 0.25
param set MC_PITCHRATE_D 0.0010
# FF + K-PID 偏航角速度
param set MC_YAWRATE_FF 0.0
param set MC_YAWRATE_K 1.0
param set MC_YAWRATE_P 0.25
param set MC_YAWRATE_I 0.25
param set MC_YAWRATE_D 0.00

#param set MC_AIRMODE 0
#param set MC_YAW_WEIGHT 0.4

# ==================================
# 5. 悬停与最大角度
# ==================================
# 悬停油门
param set MPC_USE_HTE 0
param set MPC_THR_HOVER 0.20
param set MPC_THR_MIN 0.01

# 最大倾斜角
param set MPC_TILTMAX_AIR 80.0
# 最大加加速度
param set MPC_JERK_MAX 150.0

# 倾斜角上限
param set FD_FAIL_R 90
param set FD_FAIL_P 90

