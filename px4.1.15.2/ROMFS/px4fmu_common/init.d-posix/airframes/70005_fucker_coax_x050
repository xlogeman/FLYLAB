#!/bin/sh
#
# @name Fucker Coax X050 (共轴双旋翼试验机, 起飞重量1.5kg, 14寸桨, 推重比约3.1)
#
# @type Custom (Coaxial Twin-Rotor with Tilting Mounts)
#
# 布局: 上下两桨共轴叠放, 无机臂
#   - 油门: 两桨同油门 (各承载一半升力)
#   - 偏航: 上下桨转速差动 (上桨 CCW, 下桨 CW)
#   - 俯仰/滚转: 倾转电机架 (roll/pitch 指令差动倾转上下桨, 最大 0.25rad ≈ 14.3°)
#
# 仿真端对应: BeimingSim/Plugins/AirSim (PhysicsParams RotorCount=2)
#   settings_X050.json + MavLinkMultirotorApi (HIL_ACTUATOR_CONTROLS 通道 2/3 = 倾转指令)
# 需配合 BEIMING coax patch: control_allocator/ActuatorEffectiveness/ActuatorEffectivenessCustom.cpp
#   (恢复 KM 反扭矩, 否则 Custom 机型无偏航)
#
# 通道分配 (HIL_ACTUATOR_CONTROLS):
#   controls[0] 上桨油门    controls[1] 下桨油门
#   controls[2] roll 倾转   controls[3] pitch 倾转 ([-1,1] × MaxTiltAngle)
#

# 设置 VEHICLE_TYPE=mc 并启动多旋翼应用栈 (ekf2 / mc_pos_control / mc_att_control 等)
. ${R}etc/init.d/rc.mc_defaults

# ==================================================================================================================
# 0. 控制分配 - Custom 机型: 2 电机 (KM 差动出偏航) + 2 舵机 (倾转出俯仰/滚转)
#    物理参数与 settings_X050.json PhysicsParams 联动:
#    KM = CP/CT * D/(2π) = 0.040164/0.109919 * 0.35/(2π) ≈ 0.0204 (反扭矩系数)
# ==================================================================================================================
param set-default CA_AIRFRAME 9                 # Custom 布局; 9 = Custom (电机 + 自定义力矩舵机)
param set-default CA_ROTOR_COUNT 2              # 共轴两桨

# 两桨均在中轴上 (PX=PY=0 => 无俯仰/滚转力矩), 轴朝上
param set-default CA_ROTOR0_PX 0.0              # 上桨 (CCW)
param set-default CA_ROTOR0_PY 0.0
param set-default CA_ROTOR0_PZ 0.0
param set-default CA_ROTOR0_AX 0.0              # 旋翼轴 (0,0,-1) = 朝上 (NED)
param set-default CA_ROTOR0_AY 0.0
param set-default CA_ROTOR0_AZ -1.0
param set-default CA_ROTOR0_KM 0.02             # 上桨反扭矩系数 (CCW -> +yaw, 与 sim initializeRotorCoax 约定一致)

param set-default CA_ROTOR1_PX 0.0              # 下桨 (CW)
param set-default CA_ROTOR1_PY 0.0
param set-default CA_ROTOR1_PZ 0.0
param set-default CA_ROTOR1_AX 0.0
param set-default CA_ROTOR1_AY 0.0
param set-default CA_ROTOR1_AZ -1.0
param set-default CA_ROTOR1_KM -0.02            # 下桨反扭矩系数 (CW -> -yaw)

# 倾转舵机 x2 (Type 12 = Custom, 三轴力矩系数可配):
#   CS0 -> roll 倾转: TRQ_R=1 (正指令 -> 桨盘右倾 -> 右滚, 与 sim RotorActuator 绕机体 x 轴约定一致)
#   CS1 -> pitch 倾转: TRQ_P=1 (正指令 -> 桨盘后倾 -> 抬头)
#   符号若与 sim 实测相反, 直接翻转对应 TRQ 参数即可, 无需改代码
param set-default CA_SV_CS_COUNT 2

param set-default CA_SV_CS0_TYPE 12             # Custom
param set-default CA_SV_CS0_TRQ_R 1.0           # 滚转力矩系数
param set-default CA_SV_CS0_TRQ_P 0.0
param set-default CA_SV_CS0_TRQ_Y 0.0
param set-default CA_SV_CS0_TRIM 0.0            # 0 -> 桨盘水平

param set-default CA_SV_CS1_TYPE 12             # Custom
param set-default CA_SV_CS1_TRQ_R 0.0
param set-default CA_SV_CS1_TRQ_P 1.0           # 俯仰力矩系数
param set-default CA_SV_CS1_TRQ_Y 0.0
param set-default CA_SV_CS1_TRIM 0.0

# 输出映射: 通道 1/2 = 电机, 通道 3/4 = 倾转舵机 (顺序必须与 sim 端读取一致: 电机在前, 舵机紧随)
param set-default PWM_MAIN_FUNC1 101            # Motor 1 (上桨)
param set-default PWM_MAIN_FUNC2 102            # Motor 2 (下桨)
param set-default PWM_MAIN_FUNC3 201            # Servo 1 (roll 倾转)
param set-default PWM_MAIN_FUNC4 202            # Servo 2 (pitch 倾转)


# ==================================
# 1. 悬停与油门 (Cosys-AirSim 推力 ∝ 油门【线性】, 源码 RotorActuator.hpp:
#    thrust = control_signal * max_thrust, 与 PhysicsParams 联动:
#    单桨最大推力 = CT×1.225×(MaxRPM/60)²×D⁴ = 0.109919×1.225×106.61²×0.35⁴ ≈ 22.96N
#    悬停油门 = 1.5×9.81/2 / 22.96 ≈ 0.32, 即 1/推重比, 推重比 = 2×22.96/(1.5×9.81) ≈ 3.12)
# ==================================
param set MPC_USE_HTE 0
param set MPC_THR_HOVER 0.32
param set MPC_THR_MIN 0.05
param set MPC_THR_MAX 0.95

# 最大倾斜角: 受倾转电机架物理限制 (sim MaxTiltAngle=0.25rad≈14.3°), 留 0.3° 裕量
# 最大水平加速度 ≈ g·tan(14°) ≈ 2.5 m/s², 后续所有速度/加速度限制以此为上界
param set MPC_TILTMAX_AIR 14.0


# ==================================
# 2. 速度与加速度限制 (按倾转能力 2.5 m/s² 折算, 远低于常规四轴)
# ==================================
param set MPC_XY_VEL_MAX 4.0
param set MPC_Z_VEL_MAX_UP 3.0
param set MPC_Z_VEL_MAX_DN 1.5
param set MPC_ACC_HOR_MAX 2.0
param set MPC_ACC_UP_MAX 2.0
param set MPC_ACC_DOWN_MAX 1.2


# ==================================
# 3. 位置控制器 (共轴机机动性弱, 增益温和防振荡)
# ==================================
param set MPC_XY_P 0.8
param set MPC_Z_P 1.0
param set MPC_XY_ERR_MAX 2.0
param set MPC_XY_TRAJ_P 0.4


# ==================================
# 4. 速度控制器 (默认增益即可, 倾转响应慢先不动)
# ==================================
param set MPC_XY_VEL_P_ACC 1.4
param set MPC_XY_VEL_I_ACC 0.4
param set MPC_XY_VEL_D_ACC 0.2
param set MPC_Z_VEL_P_ACC 1.0
param set MPC_Z_VEL_I_ACC 2.0
param set MPC_Z_VEL_D_ACC 0.0


# ==================================
# 5. 姿态与角速度控制器
#    注意: 俯仰/滚转力矩来自倾转舵机 (舵机动力学 + 0.05s 低通 + 最大14°),
#    比电机反扭矩响应慢且弱; 偏航来自转速差动也偏慢 -> 限速率 + 低增益起步
#    理论力矩: 满舵滚转 ≈ mg·sin(14°)·h (h≈桨高差/2≈0.04m) ≈ 0.15 N·m, 量级远小于常规四轴
# ==================================
param set MC_ROLL_P 8.0
param set MC_PITCH_P 8.0
param set MC_YAW_P 3.0
param set MC_ROLLRATE_MAX 120.0
param set MC_PITCHRATE_MAX 120.0
param set MC_YAWRATE_MAX 60.0

param set MC_ROLLRATE_FF 0.1
param set MC_ROLLRATE_K 1.0
param set MC_ROLLRATE_P 0.08
param set MC_ROLLRATE_I 0.15
param set MC_ROLLRATE_D 0.001
param set MC_PITCHRATE_FF 0.1
param set MC_PITCHRATE_K 1.0
param set MC_PITCHRATE_P 0.08
param set MC_PITCHRATE_I 0.15
param set MC_PITCHRATE_D 0.001
param set MC_YAWRATE_FF 0.0
param set MC_YAWRATE_K 1.0
param set MC_YAWRATE_P 0.2
param set MC_YAWRATE_I 0.2
param set MC_YAWRATE_D 0.00
