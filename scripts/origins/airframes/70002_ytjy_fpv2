#!/bin/sh
#
# @name YTJY FPV RPM=15800 MAS=1.0kg 推重比10:1
#
# @type Quadrotor Wide
#

. ${R}etc/init.d/rc.mc_defaults


# ==================================================================================================================
# 0. AirSim 机体和电机的几何描述 (高精度匹配 AirSim 物理模型)
# ==================================================================================================================
param set CA_AIRFRAME 0                 # 设置机架类型为通用四轴; 范围[0-20]
param set CA_ROTOR_COUNT 4              # 设置电机数量为4; 范围[2-12]

param set CA_ROTOR0_PX 0.16086679       # 电机0(前右)X坐标(米)
param set CA_ROTOR0_PY 0.16086679       # 电机0(前右)Y坐标(米)
param set CA_ROTOR0_KM 0.01329415       # 电机0力矩系数(CCW转向)

param set CA_ROTOR1_PX -0.16086679      # 电机1(后左)X坐标(米)
param set CA_ROTOR1_PY -0.16086679      # 电机1(后左)Y坐标(米)
param set CA_ROTOR1_KM 0.01329415       # 电机1力矩系数(CCW转向)

param set CA_ROTOR2_PX 0.16086679       # 电机2(前左)X坐标(米)
param set CA_ROTOR2_PY -0.16086679      # 电机2(前左)Y坐标(米)
param set CA_ROTOR2_KM -0.01329415      # 电机2力矩系数(CW转向)

param set CA_ROTOR3_PX -0.16086679      # 电机3(后右)X坐标(米)
param set CA_ROTOR3_PY 0.16086679       # 电机3(后右)Y坐标(米)
param set CA_ROTOR3_KM -0.01329415      # 电机3力矩系数(CW转向)

param set PWM_MAIN_FUNC1 101            # 映射输出通道1为电机1功能
param set PWM_MAIN_FUNC2 102            # 映射输出通道2为电机2功能
param set PWM_MAIN_FUNC3 103            # 映射输出通道3为电机3功能
param set PWM_MAIN_FUNC4 104            # 映射输出通道4为电机4功能

# ==================================
# 1.位置控制器
# ==================================
# P项增益
param set MPC_XY_P 0.7
param set MPC_Z_P 0.0
# 最大速度限制
param set MPC_XY_VEL_MAX 40.0
param set MPC_Z_VEL_MAX_UP 10.0
param set MPC_Z_VEL_MAX_DN 10.0
# 轨迹等待与贴合
param set MPC_XY_ERR_MAX 2.0
param set MPC_XY_TRAJ_P 0.5


# ==================================
# 2.速度控制器
# ==================================
# 低通滤波
param set MPC_VEL_LP 0.0
param set MPC_VELD_LP 0.0
# 水平PID
param set MPC_XY_VEL_P_ACC 0.9
param set MPC_XY_VEL_I_ACC 0.1
param set MPC_XY_VEL_D_ACC 0.03
# 垂直PID
param set MPC_Z_VEL_P_ACC 4.0
param set MPC_Z_VEL_I_ACC 2.0
param set MPC_Z_VEL_D_ACC 0.0
# 最大加速度限制
param set MPC_ACC_HOR_MAX 60.0
param set MPC_ACC_UP_MAX 8.0
param set MPC_ACC_DOWN_MAX 8.0


# ==================================
# 3. 姿态控制器
# ==================================
# P项增益
param set MC_ROLL_P 11.7
param set MC_PITCH_P 11.7
param set MC_YAW_P 4.0
# 最大角速度限制
param set MC_ROLLRATE_MAX 1500.0
param set MC_PITCHRATE_MAX 1500.0
param set MC_YAWRATE_MAX 600.0


# ==================================
# 4. 角速度控制器
# ==================================
# 低通滤波
param set IMU_GYRO_CUTOFF 0.0
param set IMU_DGYRO_CUTOFF 0.0
# FF + K-PID 滚动角速度
param set MC_ROLLRATE_FF 0.061
param set MC_ROLLRATE_K 1.0
param set MC_ROLLRATE_P 0.077
param set MC_ROLLRATE_I 0.13
param set MC_ROLLRATE_D 0.00033
# FF + K-PID 仰角速度
param set MC_PITCHRATE_FF 0.061
param set MC_PITCHRATE_K 1.0
param set MC_PITCHRATE_P 0.077
param set MC_PITCHRATE_I 0.13
param set MC_PITCHRATE_D 0.00033
# FF + K-PID 偏航角速度
param set MC_YAWRATE_FF 0.0
param set MC_YAWRATE_K 1.0
param set MC_YAWRATE_P 0.25
param set MC_YAWRATE_I 0.25
param set MC_YAWRATE_D 0.00

param set MC_AIRMODE 1
#param set MC_YAW_WEIGHT 0.4

# ==================================
# 5. 悬停与最大角度
# ==================================
# 悬停油门
param set MPC_USE_HTE 0
param set MPC_THR_HOVER 0.098
param set MPC_THR_MIN 0.01
param set MIS_TAKEOFF_ALT 5.0

# 最大倾斜角
param set MPC_TILTMAX_AIR 85.0
# 最大加加速度
param set MPC_JERK_MAX 200.0

# 倾斜角上限
param set FD_FAIL_R 120
param set FD_FAIL_P 120

# ==================================
# 5. 其他
# ==================================
# 起飞后才开始记录日志
param set SDLOG_MODE 0

# 设置为完美GPS，确保PX4自身定位准确
param set EKF2_GPS_P_GATE 1.2
param set EKF2_GPS_V_GATE 1.2
param set EKF2_GPS_DELAY 0.0
param set EKF2_GPS_P_NOISE 0.01
param set EKF2_GPS_V_NOISE 0.01
