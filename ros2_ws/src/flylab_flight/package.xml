<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flylab_flight</name>
  <version>0.2.0</version>
  <description>PX4 + AirSim SITL course toolkit: C++ offboard control nodes, launch files and rviz configs.</description>
  <maintainer email="xlogeman@gmail.com">xlogeman</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>octomap_msgs</depend>
  <depend>std_msgs</depend>
  <depend>quadrotor_msgs</depend>
  <!-- SUPER 输出桥接节点 (super_cmd_bridge.cpp) 编译依赖 -->
  <depend>mars_quadrotor_msgs</depend>

  <!-- AirSim 直连传感器节点 (airsim_sensor_ego.cpp / airsim_sensor_vio.cpp / airsim_sensor_orb.cpp) 编译依赖 -->
  <depend>cv_bridge</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- EGO 链路运行时依赖 -->
  <exec_depend>ego_planner</exec_depend>

  <!-- SUPER 避障链路运行时依赖 -->
  <exec_depend>super_planner</exec_depend>

  <!-- MAVROS 链路运行时依赖 -->
  <exec_depend>mavros</exec_depend>

  <!-- 感知链路运行时依赖 -->
  <exec_depend>depth_image_proc</exec_depend>
  <exec_depend>octomap_server</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- vins_mono VINS+GPS 融合链路运行时依赖 -->
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>airsim_ros_pkgs</exec_depend>
  <exec_depend>vins</exec_depend>
  <exec_depend>loop_fusion</exec_depend>
  <exec_depend>global_fusion</exec_depend>

  <!-- ORB-SLAM3 双目+IMU 链路运行时依赖 -->
  <exec_depend>orbslam3</exec_depend>

  <!-- OpenVINS MSCKF 链路运行时依赖 -->
  <exec_depend>ov_msckf</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
