    "单桨最大推力N": "CT * 1.225 * (MaxRPM/60)^2 * PropDiameter^4 = 0.109919*1.225*106.61^2*0.2286^4 ≈ 4.18 (源码 max_thrust=4.179)",
    "推重比": "4 * 4.18 / (1.0 * 9.81) ≈ 1.70",
    "悬停油门": "1/推重比 ≈ 0.59 (Cosys-AirSim 推力与油门线性: RotorActuator.hpp thrust = control_signal * max_thrust)",
    "反扭矩系数KM": "CP/CT * PropDiameter/(2*pi) = 0.040164/0.109919*0.2286/(2*pi) ≈ 0.0133",
    "电机坐标PX_PY": "ArmLengths/sqrt(2) = 0.2275/sqrt(2) ≈ 0.1609"
  },
